---
// Peacock's two generation pipelines: component source → manifest → framework packages, and
// design tokens → theme engine → CSS for the build and a browser bundle for the theme builder.
const outputs = [
  { y: 36, label: "@redvars/peacock-react", sub: "onInput · onChange" },
  { y: 88, label: "@redvars/peacock-vue", sub: "v-model" },
  { y: 140, label: "@redvars/peacock-angular", sub: "ngModel · formControl" },
];
const tokenOutputs = [
  { y: 252, label: "tokens.css", sub: "default theme, at build time" },
  { y: 310, label: "theme.js", sub: "same engine, in the browser" },
];
---

<svg class="diagram" viewBox="0 0 760 370" role="img" aria-labelledby="pipeline-title pipeline-desc">
  <title id="pipeline-title">Peacock's generation pipelines</title>
  <desc id="pipeline-desc">
    Component source written in Lit and TypeScript is analysed into custom-elements.json, from which
    React, Vue and Angular packages are generated. Design tokens in DTCG format and a theme config go
    through one theme engine that produces tokens.css at build time and theme.js for the browser.
  </desc>
  <defs>
    <marker id="pl-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="arrow-head-accent"></path>
    </marker>
  </defs>

  <text class="tag" x="20" y="24">01 · COMPONENTS</text>
  <rect class="box" x="20" y="60" width="190" height="70" rx="12"></rect>
  <text class="label" x="36" y="90">Component source</text>
  <text class="sub" x="36" y="110">Lit · TypeScript</text>

  <path class="edge-accent" d="M210 95 L268 95" marker-end="url(#pl-arrow)"></path>

  <rect class="box-accent" x="270" y="60" width="200" height="70" rx="12"></rect>
  <text class="code" x="286" y="90">custom-elements.json</text>
  <text class="sub" x="286" y="110">the public API, analysed</text>

  {
    outputs.map((o) => (
      <>
        <path class="edge-accent" d={`M470 95 C500 95 500 ${o.y + 22} 528 ${o.y + 22}`} marker-end="url(#pl-arrow)" />
        <rect class="box" x="530" y={o.y} width="214" height="44" rx="10" />
        <text class="label-sm" x="544" y={o.y + 19}>{o.label}</text>
        <text class="sub" x="544" y={o.y + 35}>{o.sub}</text>
      </>
    ))
  }

  <line class="rule" x1="20" y1="205" x2="740" y2="205"></line>

  <text class="tag" x="20" y="232">02 · TOKENS</text>
  <rect class="box" x="20" y="262" width="190" height="70" rx="12"></rect>
  <text class="label" x="36" y="292">DTCG tokens</text>
  <text class="sub" x="36" y="312">+ theme.config.json</text>

  <path class="edge-accent" d="M210 297 L268 297" marker-end="url(#pl-arrow)"></path>

  <rect class="box-accent" x="270" y="262" width="200" height="70" rx="12"></rect>
  <text class="label" x="286" y="292">Theme engine</text>
  <text class="sub" x="286" y="312">pure ESM, no node:* imports</text>

  {
    tokenOutputs.map((o) => (
      <>
        <path class="edge-accent" d={`M470 297 C500 297 500 ${o.y + 22} 528 ${o.y + 22}`} marker-end="url(#pl-arrow)" />
        <rect class="box" x="530" y={o.y} width="214" height="44" rx="10" />
        <text class="code" x="544" y={o.y + 19}>{o.label}</text>
        <text class="sub" x="544" y={o.y + 35}>{o.sub}</text>
      </>
    ))
  }
</svg>

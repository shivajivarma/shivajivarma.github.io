---
// Where Redvars rules run around a record write: sync before- and after-rules inside the write's
// transaction, and async after-rules queued in that same transaction and run once by rules-worker.
// Source: redvars/platform packages/modules/rules/README.md.
---

<svg class="diagram" viewBox="0 0 760 360" role="img" aria-labelledby="rp-title rp-desc">
  <title id="rp-title">Where rules run around a write</title>
  <desc id="rp-desc">
    A write enters a transaction. Before-rules run first and may set fields or reject the write. The
    row is written, then sync after-rules run in the same transaction. Async after-rules are queued
    as one job each, also in that transaction, so a rolled-back write queues nothing. After commit,
    the rules-worker claims each job and runs it once, in a transaction of its own.
  </desc>
  <defs>
    <marker id="rp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="arrow-head-accent"></path>
    </marker>
    <marker id="rp-arrow-muted" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="arrow-head"></path>
    </marker>
  </defs>

  <rect class="region" x="128" y="30" width="612" height="160" rx="16"></rect>
  <text class="tag" x="148" y="54">ONE TRANSACTION · THE CALLER'S WRITE</text>

  <rect class="box" x="20" y="76" width="92" height="92" rx="12"></rect>
  <text class="label" x="36" y="104">Write</text>
  <text class="sub" x="36" y="126">create</text>
  <text class="sub" x="36" y="142">update</text>
  <text class="sub" x="36" y="158">delete</text>

  <path class="edge-accent" d="M112 121 L146 121" marker-end="url(#rp-arrow)"></path>

  <rect class="box-accent" x="148" y="76" width="160" height="92" rx="12"></rect>
  <text class="label" x="164" y="104">Before-rules</text>
  <text class="sub" x="164" y="126">sync, in order</text>
  <text class="sub" x="164" y="142">set fields</text>
  <text class="sub" x="164" y="158">or reject the write</text>

  <path class="edge-accent" d="M308 121 L342 121" marker-end="url(#rp-arrow)"></path>

  <rect class="box" x="344" y="88" width="120" height="66" rx="12"></rect>
  <text class="label" x="360" y="117">Row written</text>
  <text class="sub" x="360" y="137">persistence</text>

  <path class="edge-accent" d="M464 121 L498 121" marker-end="url(#rp-arrow)"></path>

  <rect class="box-accent" x="500" y="76" width="220" height="92" rx="12"></rect>
  <text class="label" x="516" y="104">After-rules</text>
  <text class="sub" x="516" y="126">sync: run now, commit</text>
  <text class="sub" x="516" y="142">or roll back with the row</text>
  <text class="sub" x="516" y="158">async: queue one job each</text>

  <path class="edge" d="M610 168 L610 236" marker-end="url(#rp-arrow-muted)"></path>
  <text class="sub" x="620" y="206">after commit</text>

  <rect class="box" x="148" y="238" width="250" height="92" rx="12"></rect>
  <text class="label" x="164" y="266">Job queue</text>
  <text class="sub" x="164" y="288">the job is written in the write's</text>
  <text class="sub" x="164" y="304">transaction: a rollback queues</text>
  <text class="sub" x="164" y="320">nothing</text>

  <path class="edge-accent" d="M398 284 L498 284" marker-end="url(#rp-arrow)"></path>
  <text class="sub" x="416" y="274">claimed</text>

  <rect class="box-accent" x="500" y="238" width="220" height="92" rx="12"></rect>
  <text class="label" x="516" y="266">rules-worker</text>
  <text class="sub" x="516" y="288">runs the job once, in one</text>
  <text class="sub" x="516" y="304">transaction; on error it rolls</text>
  <text class="sub" x="516" y="320">back and records a failed run</text>

  <path class="edge" d="M273 168 L273 236" marker-end="url(#rp-arrow-muted)"></path>
  <text class="sub" x="283" y="206">enqueue</text>
</svg>

---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { FORMATS, type Format } from "../../content.config";
import { FEED_URL } from "../../siteconfig";
import { getPosts, sheetNumber } from "../../utils/posts";

const posts = await getPosts();
const [newest, ...rest] = posts;

const counts = Object.fromEntries(
  (Object.keys(FORMATS) as Format[]).map((f) => [f, posts.filter((p) => p.data.format === f).length]),
) as Record<Format, number>;
---

<Base
  title="Architecture journal"
  description="White papers, case studies and field notes on how Shivaji Varma designs and builds platforms, design systems and web components."
>
  <header class="journal-hero">
    <div class="blueprint"></div>
    <div class="glow"></div>
    <div class="wrap journal-hero-inner">
      <span class="eyebrow">Architecture journal</span>
      <h1 class="journal-title">Notes from the <span class="grad">drawing board.</span></h1>
      <p class="journal-lede">
        How my projects are designed and built: the decisions, the trade-offs and what I'd do
        differently. Written for engineers who build platforms and design systems.
      </p>

      <ul class="legend" aria-label="Kinds of posts">
        {
          (Object.keys(FORMATS) as Format[]).map((f) => (
            <li>
              <wc-icon name={FORMATS[f].icon} />
              <span>{FORMATS[f].label}</span>
              <span class="mono legend-count">{String(counts[f]).padStart(2, "0")}</span>
            </li>
          ))
        }
        <li class="legend-rss">
          <a href={FEED_URL}>
            <wc-icon name="rss_feed"></wc-icon>
            RSS
          </a>
        </li>
      </ul>
    </div>
  </header>

  <section class="wrap journal-body" aria-label="Posts">
    {
      newest ? (
        <>
          <div class="newest" data-reveal>
            <span class="mono list-label">Latest</span>
            <PostCard post={newest} sheet={sheetNumber(newest, posts)} large headingLevel="h2" />
          </div>

          {rest.length > 0 && (
            <>
              <span class="mono list-label">Earlier</span>
              <div class="grid">
                {rest.map((post, i) => (
                  <div data-reveal style={`--reveal-index:${i % 3}`}>
                    <PostCard post={post} sheet={sheetNumber(post, posts)} headingLevel="h2" />
                  </div>
                ))}
              </div>
            </>
          )}
        </>
      ) : (
        <div class="empty">
          <wc-illustration name="coming-soon" size="md" />
          <h2>The first notes are on the drawing board.</h2>
          <p>Subscribe to the RSS feed to hear when they're published.</p>
        </div>
      )
    }
  </section>
</Base>

<style>
  .journal-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4rem);
    border-bottom: 1px solid var(--hairline);
  }
  .journal-hero .glow {
    top: -22rem;
    right: -12rem;
  }
  .journal-hero-inner {
    position: relative;
    display: grid;
    gap: var(--spacing-250);
    justify-items: start;
  }
  .journal-title {
    max-width: 18ch;
    font-size: clamp(2.5rem, 6.5vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .journal-lede {
    max-width: 40rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--ink-soft);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-100);
    margin: var(--spacing-100) 0 0;
    padding: 0;
    list-style: none;

    li,
    a {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-100);
    }
    li {
      padding: var(--spacing-075) var(--spacing-150);
      border: 1px solid var(--hairline);
      border-radius: var(--shape-corner-full);
      background: color-mix(in srgb, var(--color-surface) 75%, transparent);
      font-size: 0.875rem;
      font-weight: 500;
      --icon-size: 1.05rem;
      --icon-color: var(--color-primary);
    }
    a {
      text-decoration: none;
    }
    .legend-rss:hover {
      border-color: var(--color-primary);
    }
  }
  .legend-count {
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .journal-body {
    display: grid;
    gap: var(--spacing-300);
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(4rem, 9vw, 7rem);
  }
  .newest {
    display: grid;
    gap: var(--spacing-200);
    margin-bottom: var(--spacing-300);
  }
  .list-label {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .grid {
    display: grid;
    gap: var(--spacing-300);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .empty {
    display: grid;
    justify-items: center;
    gap: var(--spacing-150);
    padding-block: var(--spacing-800);
    text-align: center;

    h2 {
      font-size: 1.5rem;
    }
    p {
      color: var(--ink-soft);
    }
  }
</style>

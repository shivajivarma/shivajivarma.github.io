---
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  SITE_TITLE,
  SITE_TAGLINE,
  SITE_DESCRIPTION,
  SITE_URL,
  SITE_TYPE,
  GOOGLE_ANALYTICS_ID,
  AUTHOR,
  PEACOCK_CDN,
  FEED_URL,
} from "../siteconfig";
import "../styles/global.scss";

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  /** "article" for journal posts. */
  ogType?: string;
  image?: string;
  /** Keep the page out of search results and give it no canonical URL (the 404 page). */
  noindex?: boolean;
}

const {
  title,
  description,
  keywords = [],
  ogType = SITE_TYPE,
  image = `${SITE_URL}${AUTHOR.avatar}`,
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? `${title} · ${SITE_TITLE}`
  : `${SITE_TITLE} · ${SITE_TAGLINE}`;
const pageDescription = description ?? SITE_DESCRIPTION;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Components seen above the fold, preloaded so the header doesn't wait on the loader's discovery.
const preload = ["site-header.js", "icon.js", "icon-button.js", "link-button.js"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={AUTHOR.name} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}

    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content={`@${AUTHOR.twitter}`} />
    <meta name="theme-color" content="#be0b0e" />

    <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/img/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} · Journal`} href={FEED_URL} />

    <!-- Apply a saved theme before first paint; with none saved, Peacock follows the system setting. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "dark" || theme === "light") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Mono:wght@400..600&family=Noto+Sans:ital,wght@0,400..700;1,400..700&family=Space+Grotesk:wght@500..700&display=swap"
    />
    <link rel="stylesheet" href={`${PEACOCK_CDN}/assets/styles.css`} />
    {preload.map((file) => <link rel="modulepreload" href={`${PEACOCK_CDN}/${file}`} crossorigin />)}

    <GoogleAnalytics id={GOOGLE_ANALYTICS_ID} />
    <slot name="head" />
  </head>

  <body>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script is:inline type="module" src={`${PEACOCK_CDN}/loader.js`}></script>
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
